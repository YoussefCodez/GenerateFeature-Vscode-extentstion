{
  "name": "generate-feature",
  "publisher": "YoussefCodez",
  "displayName": "Generate Feature",
  "description": "Generate feature-based Clean Architecture folder structures (data / domain / presentation) with customizable layers and Flutter boilerplate support.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:generate-feature.addFeature"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "generate-feature.addFeature",
        "title": "Generate Feature Structure",
        "category": "Generate Feature",
        "icon": "$(file-directory-create)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "generate-feature.addFeature",
          "group": "navigation@1",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "Generate Feature",
      "properties": {
        "generateFeature.defaultLayers": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["data", "domain", "presentation"],
          "description": "Default layers shown in the picker."
        },
        "generateFeature.basePath": {
          "type": "string",
          "default": "lib/features",
          "description": "Base directory for features."
        },
        "generateFeature.generateBoilerplate": {
          "type": "boolean",
          "default": true,
          "description": "Generate starter boilerplate files."
        },
        "generateFeature.customTemplates": {
          "type": "array",
          "items": { "type": "object" },
          "default": [],
          "description": "Custom templates per layer."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "22.x",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  }
}
